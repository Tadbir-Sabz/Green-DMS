NODE_ENV=production
PORT=3001

# Database
DATABASE_URL=postgres://user:password@postgres:5432/greendms
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=greendms

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT
JWT_SECRET=change_me_in_production
JWT_REFRESH_SECRET=change_me_refresh_in_production

# MinIO/S3
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=greendms

# API
API_BASE_URL=https://api.yourdomain.com
WEB_BASE_URL=https://app.yourdomain.com

# Integrations
MOADIAN_API_URL=
MOADIAN_AUTH_TOKEN=
PSP_MERCHANT_ID=
PSP_CALLBACK_SECRET=

# Logging
LOG_LEVEL=info
