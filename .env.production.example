# ============================================================================
# GreenDMS — production environment template
# ----------------------------------------------------------------------------
# Copy to .env.production (or export in your orchestrator) and fill real values.
# Variable names below match exactly what the code reads:
#   - API  (apps/api):  grep "process.env" apps/api/src
#   - Web  (apps/web):  NEXT_PUBLIC_API_URL (inlined at BUILD time) and
#                       API_PROXY_TARGET (runtime same-origin /api/* proxy)
# Do NOT commit the filled file. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ============================================================================

NODE_ENV=production

# ----------------------------- API (NestJS) ---------------------------------
# Port the API listens on (main.ts uses API_PORT ?? 4000).
API_PORT=4000
# Comma-separated list of browser origins allowed for CORS.
ALLOWED_ORIGINS=https://app.yourdomain.com
# Apply pending migrations automatically on boot. In production prefer running
# `docker compose exec api node scripts/migrate.mjs up` as a deploy step and set
# AUTO_MIGRATE=false (the migrate CLI ships inside the runtime image together
# with migrations/; `npm run db:migrate` is the equivalent on a source checkout).
AUTO_MIGRATE=false

# Primary database (PostgreSQL + PostGIS). Host `postgres` matches the
# docker-compose service name; change for managed databases.
DATABASE_URL=postgres://dms:CHANGE_ME_DB_PASSWORD@postgres:5432/greendms

# RUNTIME identity used by the API process itself — MANDATORY in production.
# The two identities are deliberately different:
#   DATABASE_URL      -> migration/admin role (npm run db:migrate, AUTO_MIGRATE)
#   APP_DATABASE_URL  -> runtime role (apps/api): non-superuser, non-BYPASSRLS,
#                        owns no table, so PostgreSQL row-level security actually
#                        applies (migrations 0021/0041/0042/0043).
# With NODE_ENV=production the API REFUSES TO START when APP_DATABASE_URL is
# missing, and never silently falls back to DATABASE_URL — that fallback would
# run the whole application as a privileged role and leave RLS ineffective.
# Provision the runtime role once, out of band (never inside a migration, never
# automatically against an existing production database). Split it in two so the
# plaintext password is NEVER part of a statement: `alter role ... password '...'`
# sends the plaintext to the server, where log_statement=ddl/mod/all writes it
# verbatim into the PostgreSQL log (and error diagnostics echo it back).
#   alter role dms_app login;   -- enable LOGIN only; no password in the statement
#   \password dms_app           -- psql hashes CLIENT-SIDE (PQencryptPasswordConn)
#                                -- and sends only a SCRAM-SHA-256 verifier
# Do not paste the password into `psql -c '...'` either: that puts it in the
# shell's argv and in your shell history.
# (docker/postgres-init/10-runtime-role.sh does exactly this, non-interactively,
# for a FRESH local compose volume only; it never runs against an
# already-initialised database.)
APP_DATABASE_URL=postgres://dms_app:CHANGE_ME_APP_PASSWORD@postgres:5432/greendms

# Redis (queues, cache, throttling).
REDIS_HOST=redis
REDIS_PORT=6379

# ----------------------------- Authentication -------------------------------
# Access-token signing secret (REQUIRED — use a long random value).
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHARS
# Token lifetimes (seconds).
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# Login throttling / lockout.
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
LOGIN_WINDOW_MINUTES=10
LOGIN_MAX_PER_WINDOW=20
THROTTLE_LIMIT=100
THROTTLE_TTL_MS=60000

# ----------------------------- OTP (one-time codes) -------------------------
OTP_LENGTH=6
OTP_TTL_SECONDS=120
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_WINDOW=10
OTP_WINDOW_MINUTES=60

# ----------------------------- SMS provider ---------------------------------
# `log` writes codes to the server log (no cost/network). For real delivery use
# `http` and configure the gateway below.
# PRODUCTION: SMS_PROVIDER=log is REJECTED at startup unless you explicitly set
# SMS_ALLOW_LOG_PROVIDER=true — the app must never look like OTP delivery is
# configured when codes are only written to logs. SMS_ALLOW_LOG_PROVIDER=true is
# for throwaway demo/CI stacks only.
SMS_PROVIDER=log
# SMS_GATEWAY=kavenegar | smsir | ghasedak | farapayamak | generic
# SMS_API_KEY=your-gateway-api-key
# SMS_FROM=10001234
# farapayamak uses username/password instead of an API key:
# SMS_USERNAME=
# SMS_PASSWORD=
# SMS_TEXT_TEMPLATE=GreenDMS: کد {purpose} {code} است؛ تا {minutes} دقیقه معتبر است.
# SMS_BRAND=GreenDMS
# SMS_TIMEOUT_MS=10000

# ----------------------------- Integrations ---------------------------------
# Moadian (Iranian tax authority invoicing).
MOADIAN_ENDPOINT=
MOADIAN_API_KEY=
# Payment service provider (PSP) gateway.
PSP_ENDPOINT=
PSP_API_KEY=
PSP_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_SECRET

# ----------------------------- Object storage (POD) -------------------------
# MinIO/S3-compatible bucket for delivery proof-of-delivery photos/signatures.
# (docker-compose provides a `minio` service on port 9000.)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET
MINIO_BUCKET=greendms

# ----------------------------- Web (Next.js) --------------------------------
# API base URL for the browser bundle. NEXT_PUBLIC_* is inlined at BUILD time.
#
# Recommended (default): leave NEXT_PUBLIC_API_URL EMPTY. The web then calls
# same-origin /api/v1 and the Next server proxies /api/* to API_PROXY_TARGET
# (below). This works behind a reverse proxy / preview URL / remote host — the
# browser never assumes the API is on its own localhost — and needs no CORS.
#
# Override: set NEXT_PUBLIC_API_URL to a *separate public* API origin to call it
# directly from the browser (then ALLOWED_ORIGINS above must allow the web
# origin). It must be browser-reachable, not an internal container hostname.
NEXT_PUBLIC_API_URL=
# Server-side proxy target for same-origin /api/* requests (next.config rewrites).
# ⚠️ Baked into .next/routes-manifest.json at BUILD time (a build-arg of the web
# Docker image) — changing it at runtime has no effect; rebuild the web image.
# With docker-compose this is the api service: http://api:4000
API_PROXY_TARGET=http://api:4000
# Port the web server listens on.
WEB_PORT=3000

# ----------------------------- Logging --------------------------------------
LOG_LEVEL=info

# ----------------------------- Health endpoints (documented, no config) ------
#   GET /api/health             summary (always 200; ok|degraded + database up|down)
#   GET /api/v1/health/live     liveness (200 while the process serves)
#   GET /api/v1/health/ready    readiness (200 ready / 503 unready — DB dependency)
# Compose healthchecks and docs/deploy/PRODUCTION_DEPLOYMENT.md use these exact paths.

# ----------------------------- NEVER in real production ----------------------
# DMS_ACCEPT_INSECURE_LOCAL_SETUP=true  → skips the production config security
#   checks (placeholder/dev-default secrets, incomplete gateways) with a loud
#   warning. ONLY for the throwaway local compose stack / CI smoke tests.
# SMS_ALLOW_LOG_PROVIDER=true           → allows SMS_PROVIDER=log (OTP in logs).
# Leave both unset (or false) in production: the API refuses to boot otherwise
# when the corresponding insecure option is active (fail-closed by design).
