# ── وابستگی‌ها ────────────────────────────────────────────────
node_modules/

# ── خروجی ساخت (همه‌جا بازتولیدپذیر است؛ هرگز commit نشود) ─────
dist/
build/
out/
.next/
*.tsbuildinfo

# ── ابزارهای محلی دانلودشده (openapi-generator، JRE) ──────────
tools/

# ── پیکربندی محیط (رمزها) — فقط نمونه‌ها در repo می‌مانند ─────
.env
.env.local
.env.*.local

# ── لاگ‌ها ─────────────────────────────────────────────────────
*.log
npm-debug.log*
api-dev.log
web-dev.log
logs/

# ── اندروید/گریدل ─────────────────────────────────────────────
.gradle/
local.properties
*.apk
*.aab
*.keystore
!debug.keystore
captures/
.cxx/

# ── سیستم‌عامل/سردبیر ─────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# ── Next.js تولیدشده ──────────────────────────────────────────
next-env.d.ts

# ── پوشش تست ──────────────────────────────────────────────────
coverage/

# ── فایل‌های موقت توسعه (اسکریپت‌های یک‌بارمصرف، لاگ اجرای دستی) ──
tmp_*
*.tmp

# ── قرنطینهٔ ساخته‌های کامپایل‌شده و پیوست‌های مکالمه (هرگز commit نشود) ──
.quarantine/
.cloud-attachments/
