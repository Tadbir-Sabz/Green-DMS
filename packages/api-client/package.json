{
  "name": "@dms/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "کلاینت تایپ‌شده TypeScript برای وب — تولیدشده از packages/contracts/openapi.yaml",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "generate": "openapi-typescript ../contracts/openapi.yaml -o src/schema.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.2"
  }
}
