# اتصال پایگاه‌داده اصلی (PostgreSQL + PostGIS)
DATABASE_URL=postgres://postgres:PASSWORD@127.0.0.1:5432/greendms

# API (NestJS)
API_PORT=4000
# مهاجرت‌ها هنگام بالا آمدن API اعمال می‌شوند تا مهاجرتِ اعمال‌نشده به خطای 500 نشود؛
# AUTO_MIGRATE=false فقط وضعیت را می‌خواند و هشدار می‌دهد (اعمال دستی: npm run db:migrate)
# AUTO_MIGRATE=false

# وب (Next.js)
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# JWT احراز هویت (access token) — تولید: node -e "console.log(require(')crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHARS

# پیامک (OTP): درگاه پیش‌فرض لاگ کنسول (بدون هزینه/شبکه). برای ارسال واقعی:
SMS_PROVIDER=log
# SMS_PROVIDER=http
# SMS_GATEWAY=کاوه‌نگار/kavenegar | smsir | ghasedak | farapayamak | generic
# SMS_GATEWAY=kavenegar
# SMS_API_KEY=کلید-API-درگاه        # کاوه‌نگار/_smsir/قاصدک: کلید در مسیر یا هدر می‌رود
# SMS_FROM=10001234                 # شماره/کد فرستنده (kavenegar: خط پنل؛ smsir/ghasedak: lineNumber)
                                    # خالی/حذف = خط پیش‌فرض پنل ارسال‌کننده
# قالب متن فارسی پیامک؛ placeholderها: {code} {minutes} {purpose} {brand}
# (purpose به فارسی: ورود / بازیابی رمز / اتصال دستگاه)
# SMS_TEXT_TEMPLATE=GreenDMS: کد {purpose} {code} است؛ تا {minutes} دقیقه معتبر است. کد را در اختیار کسی قرار ندهید.
# SMS_BRAND=GreenDMS               # فقط {brand} قالب پیش‌فرض
# SMS_LOG_CODE=true                # چاپ کد OTP در لاگ لاگ-سِندر (توسعه محلی؛ پیش‌فرض: مخفی)
# SMS_API_URL=                      # بازنویسی نشانی پیش‌فرض؛ در kavenegar کلید در مسیر است،
                                    # پس اگر نشانی را عوض کردید {KEY} را برای جایگزینی کلید بگذارید:
                                    # SMS_API_URL=https://proxy.example/v1/{KEY}/sms/send.json
# SMS_TIMEOUT_MS=10000              # مهلت هر درخواست به میلی‌ثانیه
# SMS_TEST_TO=0912xxxxxxx           # شماره مقصد برای scripts/test-sms.mts
# فراپیامک به‌جای کلید، کاربر/رمز پنل می‌خواهد:
# SMS_USERNAME=
# SMS_PASSWORD=
# تست واقعی: npx tsx scripts/test-sms.mts

# OTP: عمر کد (ثانیه)، فاصله حداقلی دو ارسال، سقف تلاش تأیید هر کد
OTP_TTL_SECONDS=120
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
